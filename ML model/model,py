from pytrends.request import TrendReq

# Connect to Google
pytrends = TrendReq(hl='en-US', tz=360)

# Build the payload
kw_list = ['keyword1', 'keyword2']  # Replace with relevant keywords
pytrends.build_payload(kw_list, timeframe='now 7-d', geo='', gprop='')

# Get interest over time
data = pytrends.interest_over_time()
print(data.head())
